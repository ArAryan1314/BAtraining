# Copy to .env.local (`Copy-Item .env.example .env.local`). Next.js and the Prisma scripts both read it.

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ba_training"
# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# The site's public URL. Required by NextAuth outside Vercel.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Local development ------------------------------------------------------
# Password given to the demo accounts by `pnpm db:seed`. Required when seeding production.
SEED_USER_PASSWORD="ChangeMe123!"

# --- Reserved for provider integrations (not read by the app yet) -----------
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
EMAIL_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_SECRET=""
PAYMENT_WEBHOOK_SECRET=""
ANALYTICS_WRITE_KEY=""
