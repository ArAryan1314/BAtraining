# Copy to .env.local (`Copy-Item .env.example .env.local`). Next.js and the Prisma scripts both read it.

# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ba_training"
# Hosted databases (Vercel/Neon/Supabase): DATABASE_URL is the POOLED url used by the running app, and DIRECT_URL is the
# non-pooled one used by `prisma migrate` and `db push`. Vercel's own names (POSTGRES_URL, POSTGRES_URL_NON_POOLING,
# DATABASE_URL_UNPOOLED) are picked up automatically. Leave DIRECT_URL empty locally.
DIRECT_URL=""
# Connections held per server instance (default 5). Keep it low on serverless.
DATABASE_POOL_MAX=""
# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# The site's public URL. Required by NextAuth outside Vercel.
# Must be an https:// URL in production (the server refuses to start otherwise).
NEXTAUTH_URL="http://localhost:3000"
# Baked in at build time: sets canonical links, the sitemap and social preview URLs. Set it before `pnpm build`.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Local development ------------------------------------------------------
# Password given to the demo accounts by `pnpm db:seed`. Required when seeding production.
SEED_USER_PASSWORD="ChangeMe123!"

# --- Third-party services (see config/integrations.ts and docs/PROCUREMENT.md) --------
# Required = needed before launch. Leave a block empty until you've bought the service;
# Admin > Settings shows which ones the server can see.

# Transactional email (required): Password reset, enrolment, grading and certificate emails.
# Options: Resend, Postmark, AWS SES
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""

# Payment gateway (required): Course fees, invoices, refunds and signed webhooks.
# Options: Razorpay, Stripe, Cashfree
PAYMENT_PROVIDER_KEY_ID=""
PAYMENT_PROVIDER_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# File storage (required): Assignment attachments, avatars and downloadable resources.
# Options: Cloudflare R2, AWS S3, Vercel Blob
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Video hosting (optional): Adaptive, access-controlled lesson video instead of public links.
# Options: Mux, Cloudflare Stream, Vimeo OTT
VIDEO_PROVIDER_TOKEN_ID=""
VIDEO_PROVIDER_TOKEN_SECRET=""

# Shared rate-limit store (required): Makes sign-in throttling work across every server instance.
# Options: Upstash Redis, Vercel KV
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Bot protection (optional): Stops spam on the contact form and credential stuffing on sign-in.
# Options: Cloudflare Turnstile, hCaptcha
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Error monitoring (required): Captures server and browser exceptions that today only reach console.error.
# Options: Sentry, Highlight, Datadog
SENTRY_DSN=""

# Product analytics (optional): Funnels, retention and course engagement beyond the built-in progress events.
# Options: PostHog, Plausible, Mixpanel
ANALYTICS_WRITE_KEY=""

# Live classes (optional): Scheduled cohort sessions with attendance and recordings.
# Options: Zoom Meeting SDK, Daily, Google Meet API
LIVE_CLASS_API_KEY=""

# SMS / WhatsApp reminders (optional): Deadline and session reminders where email is ignored.
# Options: Twilio, MSG91, Gupshup
MESSAGING_PROVIDER_KEY=""

# AI study assistant (optional): Answers learner questions and drafts feedback for trainers to approve.
# Options: Anthropic Claude API
ANTHROPIC_API_KEY=""
